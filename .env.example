# ------------------------------------------------------------------------------
# Optional Firebase Cloud Sync & Friend Sharing Configuration
# ------------------------------------------------------------------------------
# Leave all variables unset (or omit .env.local) to run Ripple99 ("Build Decks,
# Not Piles") 100% locally in your browser via IndexedDB with zero cloud calls.
#
# To enable cloud accounts, deck sync, share links, and friend catalogs:
#   1. Copy this file to `.env.local` for local dev (never commit secrets).
#   2. Add the same `VITE_FIREBASE_*` variables in Cloudflare Pages -> Settings
#      -> Environment variables (Production and Preview) and redeploy.
#   3. Follow CLOUD_SETUP.md for full free-tier Firebase Spark setup steps.
#
# Note: These values are public Firebase client identifiers (not private admin
# secrets). Access control is enforced server-side by `firestore.rules`.
# ------------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google Cloud Fraud Defense (reCAPTCHA Enterprise) site key for Firebase App Check
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Optional (local dev on localhost ONLY): set to `true` or a registered App Check debug UUID.
# Never set this in Cloudflare Pages or production environments.
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# ------------------------------------------------------------------------------
# Optional Cookie-Less Cloudflare Web Analytics
# ------------------------------------------------------------------------------
# Leave unset to disable analytics completely. Set your Cloudflare Web Analytics
# site token in Cloudflare Pages -> Settings -> Environment variables to inject
# the deferred, cookie-less Cloudflare beacon script at runtime.
VITE_CF_ANALYTICS_TOKEN=
